# Isi nomor WA untuk pairing code (format: 628xxxx, tanpa + / spasi).
# Kosongkan kalau mau pakai QR (muncul di log).
BOT_NUMBER_PAIR=

# Nama session di folder sessions/ (default: autoread).
# WAJIB beda dari readsw, biar tidak rebutan session.
BOT_SESSION_NAME=autoread

# Level log Baileys: silent / info / warn / error
BOT_LOGGER_LEVEL=silent

# Maksimal percobaan reconnect (kosong = tanpa batas)
BOT_MAX_RETRIES=
